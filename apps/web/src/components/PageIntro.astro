---
import { imagery, type ImageKey } from '../content/imagery';
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
  breadcrumbs: { label: string; href?: string }[];
  image?: ImageKey;
  red?: boolean;
}
const { eyebrow, title, accent = '', description, breadcrumbs, image, red = false } = Astro.props;
const photo = image ? imagery[image] : undefined;
---

<header class:list={['page-heading', { 'page-heading-photo': !!photo, 'page-heading-red': red }]}>
  {
    photo && (
      <>
        <>
          <img
            class="page-heading-image"
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            fetchpriority="high"
          />
          <div class="page-heading-shade" />
        </>
      </>
    )
  }
  <div class="container page-heading-inner">
    <nav class="breadcrumb" aria-label="Đường dẫn trang">
      <a href="/">Trang chủ</a>{
        breadcrumbs.map((item) => (
          <>
            <span aria-hidden="true">/</span>
            {item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current="page">{item.label}</span>
            )}
          </>
        ))
      }
    </nav><div class="page-heading-content">
      <p class="eyebrow">{eyebrow}</p><h1>{title} {accent}</h1><p class="page-heading-description">
        {description}
      </p>
    </div>
  </div>
</header>
<style>
  .page-heading {
    position: relative;
    padding-block: 30px 54px;
    overflow: hidden;
    background: #f3f4f2;
  }
  .page-heading-inner {
    position: relative;
    z-index: 1;
  }
  .page-heading .breadcrumb {
    margin-bottom: 40px;
  }
  .page-heading h1 {
    font-size: clamp(34px, 3.5vw, 50px);
    font-weight: 600;
    line-height: 1.13;
    max-width: 800px;
  }
  .page-heading-description {
    max-width: 730px;
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.75;
  }
  .page-heading-photo,
  .page-heading-red {
    color: white;
    padding-block: 30px 58px;
    min-height: 420px;
    background: var(--brand);
  }
  .page-heading-image,
  .page-heading-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .page-heading-image {
    object-fit: cover;
    object-position: center 48%;
  }
  .page-heading-shade {
    background: linear-gradient(90deg, #091e2be8 0%, #091e2bba 45%, #091e2b38 100%);
  }
  .page-heading-photo .eyebrow,
  .page-heading-red .eyebrow {
    color: #f3d9c8;
  }
  .page-heading-photo .breadcrumb,
  .page-heading-red .breadcrumb {
    color: #e1e8ec;
  }
  .page-heading-photo .breadcrumb [aria-current],
  .page-heading-red .breadcrumb [aria-current] {
    color: white;
  }
  .page-heading-photo h1,
  .page-heading-red h1 {
    max-width: 750px;
  }
  .page-heading-photo .page-heading-description,
  .page-heading-red .page-heading-description {
    color: #edf0f1;
    max-width: 660px;
  }
  .page-heading-photo :focus-visible,
  .page-heading-red :focus-visible {
    outline-color: white;
  }
  @media (max-width: 700px) {
    .page-heading {
      padding-block: 22px 36px;
    }
    .page-heading h1 {
      font-size: 34px;
    }
    .page-heading .breadcrumb {
      margin-bottom: 30px;
      font-size: 12px;
      gap: 8px;
    }
    .page-heading-description {
      font-size: 15px;
      line-height: 1.75;
      margin-top: 20px;
    }
    .page-heading-photo,
    .page-heading-red {
      min-height: 390px;
    }
    .page-heading-shade {
      background: #091e2bb8;
    }
    .page-heading-image {
      object-position: 65% center;
    }
  }
</style>
