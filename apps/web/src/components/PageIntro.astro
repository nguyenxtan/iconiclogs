---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
  breadcrumbs: { label: string; href?: string }[];
}
const { eyebrow, title, accent, description, breadcrumbs } = Astro.props;
---

<header class="page-intro container">
  <nav class="breadcrumb" aria-label="Đường dẫn trang">
    <a href="/">Trang chủ</a>
    {
      breadcrumbs.map((item) => (
        <>
          <span aria-hidden="true">/</span>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </>
      ))
    }
  </nav>
  <div class="page-intro-grid">
    <div><p class="eyebrow">{eyebrow}</p><h1>{title} {accent}</h1></div>
    <p class="page-intro-description">{description}</p>
  </div>
</header>
