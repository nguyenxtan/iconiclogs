---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Icon from '../../components/Icon.astro';
import { company, services } from '../../content/company';
import { serviceDetails } from '../../content/service-details';
import { serviceImages } from '../../content/imagery';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const detail = serviceDetails[service.slug];
---

<BaseLayout
  title={`${service.title} | ICONIC Logistics`}
  description={`${service.title} cùng ICONIC Logistics. ${service.description}`}
>
  <Header /><main id="noi-dung" tabindex="-1">
    <PageIntro
      image={serviceImages[service.slug]}
      red={service.slug === 'customs'}
      eyebrow="DỊCH VỤ LOGISTICS"
      title={service.title}
      description={detail.introduction}
      breadcrumbs={[{ label: 'Dịch vụ', href: '/services' }, { label: service.title }]}
    />
    <section class="container service-detail-content">
      <div class="service-scope">
        <p class="eyebrow">CHÚNG TÔI PHỐI HỢP NHỮNG GÌ</p><h2>Phạm vi dịch vụ</h2><p
          class="scope-introduction"
        >
          Phạm vi thực hiện được thống nhất theo hàng hóa, tuyến và nhu cầu cụ thể của doanh nghiệp.
        </p>{
          detail.scope.map((item) => (
            <article>
              <>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </>
            </article>
          ))
        }
      </div><aside class="service-preparation" aria-labelledby="prepare-title">
        <span class="prepare-icon"><Icon name="document" size={28} /></span><h2 id="prepare-title">
          Thông tin cần chuẩn bị
        </h2><p>Gửi thông tin bạn hiện có. Chúng tôi sẽ cùng làm rõ các nội dung cần bổ sung.</p><ul
        >
          {
            detail.prepare.map((item) => (
              <li>
                <>
                  <Icon name="check" size={18} />
                  <span>{item}</span>
                </>
              </li>
            ))
          }
        </ul><p class="service-note">{detail.note}</p><a
          class="button button-brand"
          href={`mailto:${company.email}?subject=${encodeURIComponent(`Yêu cầu tư vấn ${service.title.toLowerCase()}`)}`}
          >Trao đổi về dịch vụ <Icon name="arrow" size={18} /></a
        >
      </aside>
    </section>
    <section class="container related-section" aria-labelledby="related-title">
      <div class="related-heading">
        <div>
          <p class="eyebrow">CÁC CHẶNG LIÊN QUAN</p><h2 id="related-title">
            Phối hợp thêm dịch vụ
          </h2>
        </div><a class="text-link" href="/services"
          >Tất cả dịch vụ <Icon name="arrow" size={18} /></a
        >
      </div><ServiceGrid exclude={service.slug} compact />
    </section>
    <ContactCTA />
  </main><Footer />
</BaseLayout>
