---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  noindex
  title="Không tìm thấy trang | ICONIC Logistics"
  description="Đường dẫn này không tồn tại. Quay lại trang chủ ICONIC Logistics để tìm hiểu dịch vụ và liên hệ."
>
  <Header />
  <main id="noi-dung" class="container error-page">
    <p class="eyebrow">404 / KHÔNG TÌM THẤY TRANG</p><h1>
      Hãy trở lại<br /><em>đúng hành trình.</em>
    </h1><p>Đường dẫn bạn truy cập không tồn tại hoặc đã thay đổi.</p><a class="text-link" href="/"
      >Về trang chủ ICONIC <Icon name="arrow" size={20} /></a
    >
  </main>
  <Footer />
</BaseLayout>
