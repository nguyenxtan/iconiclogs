---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { company, services, process } from '../content/company';
import '../styles/home.css';
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.address)}`;
---

<BaseLayout>
  <Header />
  <main id="noi-dung" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">ICONIC LOGISTICS · VIỆT NAM</p>
        <h1 id="hero-title">
          Kết nối hành trình.<br /><em>Vững bước <span class="keep-words">giao thương.</span></em>
        </h1>
        <p class="hero-description">
          Vận tải biển, hàng không, đường bộ, thủ tục hải quan và kho bãi. Một đầu mối phối hợp, từ
          yêu cầu ban đầu đến giao nhận.
        </p>
        <div class="hero-actions">
          <a class="button button-brand" href="/contact"
            >Liên hệ báo giá <Icon name="arrow" size={19} /></a
          ><a class="hero-phone" href={`tel:+84${company.phone.slice(1)}`}
            ><Icon name="phone" size={17} />{company.phoneDisplay}</a
          >
        </div>
        <a class="hero-profile" href="/brochure"
          >Hồ sơ năng lực Việt / Anh <Icon name="northeast" size={16} /></a
        >
      </div>
      <figure class="hero-photo">
        <img
          src="/visuals/iconic-port-hero-v2.webp"
          alt="Minh họa tàu container hướng về cảng biển"
          width="1915"
          height="821"
          fetchpriority="high"
        />
      </figure>
    </section>
    <section class="home-services container" id="dich-vu" aria-labelledby="services-title">
      <div class="home-section-heading">
        <div>
          <p class="eyebrow">CHÚNG TÔI LÀM GÌ</p><h2 id="services-title">Dịch vụ logistics</h2>
        </div><p>Lựa chọn một dịch vụ hoặc phối hợp nhiều chặng theo yêu cầu của lô hàng.</p>
      </div>
      <div class="services-list">
        {
          services.map((service) => (
            <a class="service-row" href={`/services/${service.slug}`}>
              <>
                <span class="service-number">{service.number}</span>
                <Icon name={service.icon} size={26} />
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <Icon name="northeast" size={21} />
              </>
            </a>
          ))
        }
      </div>
      <a class="text-link services-more" href="/services"
        >Xem phạm vi và thông tin cần chuẩn bị <Icon name="arrow" size={18} /></a
      >
    </section>
    <section class="home-about container" id="ve-iconic" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">VỀ ICONIC</p><h2 id="about-title">Hiểu yêu cầu. Rõ trách nhiệm.</h2><p>
          ICONIC Logistics cùng doanh nghiệp xây dựng phương án vận chuyển và phối hợp các đầu mối
          liên quan. Hàng hóa, lịch trình và chứng từ được làm rõ trước khi triển khai.
        </p><a class="text-link" href="/about"
          >Tìm hiểu về chúng tôi <Icon name="arrow" size={18} /></a
        >
      </div>
      <div class="home-principles">
        <article>
          <span>01</span><div>
            <h3>Đúng nhu cầu</h3><p>Phương án dựa trên đặc điểm hàng hóa và kế hoạch thực tế.</p>
          </div>
        </article><article>
          <span>02</span><div>
            <h3>Minh bạch thông tin</h3><p>Thống nhất phạm vi, chi phí và các bước phối hợp.</p>
          </div>
        </article><article>
          <span>03</span><div>
            <h3>Theo sát thực hiện</h3><p>Chủ động cập nhật tiến độ và trao đổi khi có thay đổi.</p>
          </div>
        </article>
      </div>
    </section>
    <section class="home-process" id="cach-phoi-hop" aria-labelledby="process-title">
      <div class="container">
        <div class="home-section-heading">
          <div>
            <p class="eyebrow">CÁCH LÀM VIỆC</p><h2 id="process-title">Từng bước rõ ràng</h2>
          </div><p>
            Một quy trình trao đổi thống nhất, từ tiếp nhận yêu cầu đến hoàn tất giao nhận.
          </p>
        </div><ol class="process-list">
          {
            process.map((step, index) => (
              <li>
                <>
                  <span class="process-number">0{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
    <section class="home-contact container" id="lien-he" aria-labelledby="contact-title">
      <div>
        <p class="eyebrow">TRAO ĐỔI CÙNG ICONIC</p><h2 id="contact-title">
          Bạn cần vận chuyển gì?
        </h2><p>
          Gửi loại hàng, điểm đi – đến và thời gian dự kiến. Chúng tôi sẽ cùng bạn làm rõ phương án.
        </p><a class="button button-brand" href={`mailto:${company.email}`}
          >Gửi yêu cầu vận chuyển <Icon name="northeast" size={18} /></a
        >
      </div><address>
        <div><span>Email</span><a href={`mailto:${company.email}`}>{company.email}</a></div><div>
          <span>Điện thoại</span><a href={`tel:+84${company.phone.slice(1)}`}
            >{company.phoneDisplay}</a
          >
        </div><div>
          <span>Văn phòng</span><p>{company.address}</p><a class="map-link" href={mapUrl}
            >Xem bản đồ <Icon name="northeast" size={15} /></a
          >
        </div>
      </address>
    </section>
  </main>
  <Footer />
</BaseLayout>
