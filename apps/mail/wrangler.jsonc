{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iconiclogs-mail",
  "account_id": "ee2528cd2e60cd6a1e120d1dba703a3c",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "mail.iconiclogs.com", "custom_domain": true }],
  "limits": { "cpu_ms": 30000 },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "MAIL_ENABLED": "true",
    "MAIL_DOMAIN": "iconiclogs.com",
    "MAIL_HOST": "hl-mail29.viettelidc.com.vn",
    "MAIL_ALLOWED_USERS": "admin@iconiclogs.com,business@iconiclogs.com,cs@iconiclogs.com,customer@iconiclogs.com,director@iconiclogs.com,document@iconiclogs.com,info@iconiclogs.com",
    "SENT_MODE": "append",
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSONAL", "class_name": "PersonalState" },
      { "name": "BACKUPS", "class_name": "BackupCoordinator" },
      { "name": "SESSIONS", "class_name": "SessionVault" },
      { "name": "MAILBOXES", "class_name": "MailboxCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionVault", "MailboxCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["PersonalState", "BackupCoordinator"] },
  ],
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "iconiclogs-mail-backups" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
  },
}
