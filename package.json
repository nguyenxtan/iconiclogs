{
  "name": "iconiclogs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @iconic/web dev",
    "dev:mail": "pnpm --filter @iconic/mail dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.7.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "jsdom": "^27.0.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
